{
  "name": "boo-board",
  "private": true,
  "version": "0.3.0",
  "description": "Boo Board",
  "author": "solowey1",
  "type": "module",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces --",
    "versions": "node tools/check-versions.mjs",
    "app:install": "npm run app:install -w apps/board --",
    "app:uninstall": "npm run app:uninstall -w apps/board --",
    "app:run": "npm run app:run -w apps/board --",
    "app:stop": "npm run app:stop -w apps/board --",
    "test": "npm test --prefix mac-agent"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "devDependencies": {
    "@busy-app/cli": "^0.6.0",
    "typescript": "~6.0.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.21.1"
  },
  "workspaces": [
    "apps/*"
  ]
}
